rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

function isAuthed() {
      return request.auth != null;
    }

function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isShortOptionalString(data, field, maxLength) {
      return data.get(field, null) == null
        || (data.get(field, null) is string
          && data.get(field, null).size() <= maxLength);
    }

    function isOptionalCoordinate(data, field, minimum, maximum) {
      return data.get(field, null) == null
        || (data.get(field, null) is number
          && data.get(field, null) >= minimum
          && data.get(field, null) <= maximum);
    }

    function hasValidAlertShape(data, alertId) {
      return data.keys().hasAll([
          'id', 'userId', 'type', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'type', 'status', 'latitude', 'longitude',
          'locationLabel', 'message', 'createdAt', 'resolvedAt'
        ])
        && data.id == alertId
        && data.id is string
        && data.id.size() <= 160
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.type in ['sos', 'headsUp']
        && data.status in ['sent', 'resolved', 'cancelled']
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && isOptionalCoordinate(data, 'latitude', -90, 90)
        && isOptionalCoordinate(data, 'longitude', -180, 180)
        && isShortOptionalString(data, 'locationLabel', 200)
        && isShortOptionalString(data, 'message', 500)
        && isShortOptionalString(data, 'resolvedAt', 40);
    }

    function hasValidHeadsUpShape(data, headsUpId) {
      return data.keys().hasAll([
          'id', 'userId', 'createdAt', 'expiresAt', 'expiresAtMs', 'status'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'createdAt', 'expiresAt', 'expiresAtMs', 'note', 'status'
        ])
        && data.id == headsUpId
        && data.id is string
        && data.id.size() <= 128
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.expiresAt is string
        && data.expiresAt.size() <= 40
        && data.expiresAtMs is int
        && timestamp.value(data.expiresAtMs) > request.time - duration.value(5, 'm')
        && timestamp.value(data.expiresAtMs) <= request.time + duration.value(24, 'h')
        && isShortOptionalString(data, 'note', 500)
        && data.status in ['active', 'checkedIn', 'cancelled'];
    }

function hasValidOptionalSaPhone(data) {
      return !('phone' in data)
        || data.phone == null
        || (data.phone is string
          && data.phone.size() <= 15
          && data.phone.matches('^(0[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|\\+27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|0027[1-8][0-9]{8}|[1-8][0-9] ?[0-9]{3} ?[0-9]{4})$')
          && data.phoneNormalized is string
          && data.phoneNormalized.matches('^\\+27[1-8][0-9]{8}$'));
    }

    function hasValidRequiredSaPhone(data) {
      return 'phone' in data
        && data.phone is string
        && data.phone.size() <= 15
        && data.phone.matches('^(0[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|\\+27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|0027[1-8][0-9]{8}|[1-8][0-9] ?[0-9]{3} ?[0-9]{4})$')
        && data.phoneNormalized is string
        && data.phoneNormalized.matches('^\\+27[1-8][0-9]{8}$');
    }

match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
                    && hasValidOptionalSaPhone(request.resource.data);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['phone', 'phoneNormalized'])
                        || hasValidOptionalSaPhone(request.resource.data));
    }

match /contacts/{contactId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;

      allow create:       if isOwner(request.resource.data.userId)
                          && hasValidRequiredSaPhone(request.resource.data)
                          && !request.resource.data.keys().hasAny([
                               'linkedUid', 'inviteStatus', 'inviteExpiresAtMs'
                             ]);

      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId
                          && (!request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['phone', 'phoneNormalized'])
                              || hasValidRequiredSaPhone(request.resource.data))
                          && !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny([
                                 'linkedUid', 'inviteStatus', 'inviteExpiresAtMs'
                               ]);
    }

match /seizureLogs/{logId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId;
    }

match /alerts/{alertId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId)
                          && hasValidAlertShape(request.resource.data, alertId)
                          && request.resource.data.status == 'sent'
                          && request.resource.data.get('resolvedAt', null) == null;
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId
                          && hasValidAlertShape(request.resource.data, alertId)
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly([
                                 'latitude', 'longitude', 'locationLabel',
                                 'status', 'resolvedAt'
                               ])
                          && resource.data.status == 'sent'
                          && request.resource.data.status in [
                               'sent', 'resolved', 'cancelled'
                             ];
    }

match /headsUp/{headsUpId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId)
                          && hasValidHeadsUpShape(request.resource.data, headsUpId)
                          && request.resource.data.status == 'active';
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId
                          && hasValidHeadsUpShape(request.resource.data, headsUpId)
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status'])
                          && resource.data.status == 'active'
                          && request.resource.data.status in [
                               'active', 'checkedIn', 'cancelled'
                             ];
    }

match /alert_responses/{responseId} {

      function isResponder() {
        return isAuthed() && resource.data.responderId == request.auth.uid;
      }

function isAlertOwner() {
        return isAuthed() && resource.data.alertOwnerId == request.auth.uid;
      }

      allow read: if isResponder() || isAlertOwner();

allow create, update: if false;

      allow delete: if isResponder();
    }

match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read, write: if false;
    }

match /system/{docId} {
      allow read, write: if false;
    }
  }
}
