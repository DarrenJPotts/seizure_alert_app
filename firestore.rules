rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    /// Caller is signed in.
    function isAuthed() {
      return request.auth != null;
    }

    /// Caller is the owner identified by uid.
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Each user document is keyed by their Firebase Auth uid.

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Contacts ──────────────────────────────────────────────────────────────
    // Scoped to the owning user via the userId field on each document.

    // `linkedUid` is the verified uid of the person who accepted the invite to
    // watch this contact's owner, and it is the authorization key for every
    // cross-user read in functions/index.js. It is written only by
    // respondToInvite under the Admin SDK, which bypasses these rules. If a
    // client could write it, the owner could grant a stranger access to their
    // own emergency data with no consent from that stranger — and, worse, the
    // field would stop meaning "this person accepted".

    match /contacts/{contactId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;

      allow create:       if isOwner(request.resource.data.userId)
                          && !('linkedUid' in request.resource.data);

      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny(['linkedUid']);
    }

    // ── Seizure logs ──────────────────────────────────────────────────────────

    match /seizureLogs/{logId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid;
    }

    // ── Alerts ────────────────────────────────────────────────────────────────

    match /alerts/{alertId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid;
    }

    // ── Heads Up ──────────────────────────────────────────────────────────────

    match /headsUp/{headsUpId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid;
    }

    // ── Alert responses ───────────────────────────────────────────────────────
    // A response is written by a contact (not the patient) and read by both
    // that contact and the patient, so it can't be scoped by a single owner
    // field the way the collections above are. Instead each document carries
    // both uids: `responderId` (who wrote it) and `alertOwnerId` (whose alert
    // it belongs to), and access is the union of those two.
    //
    // These rules previously allowed any signed-in user to read the whole
    // collection and to create responses on strangers' alerts. `alertOwnerId`
    // was added specifically so this could be locked down with plain field
    // comparisons — no get() into /alerts, which would spend a document read
    // on every rule evaluation.

    match /alert_responses/{responseId} {
      /// The contact who wrote this response.
      function isResponder() {
        return isAuthed() && resource.data.responderId == request.auth.uid;
      }

      /// The person the underlying alert belongs to.
      function isAlertOwner() {
        return isAuthed() && resource.data.alertOwnerId == request.auth.uid;
      }

      allow read: if isResponder() || isAlertOwner();

      // All writes go through the submitAlertResponse Cloud Function, which
      // runs under the Admin SDK and so bypasses these rules.
      //
      // Client writes used to be allowed if `responderId == auth.uid`. That
      // proved the writer was not impersonating another responder, but not
      // that they had anything to do with the alert: `alertId` and
      // `alertOwnerId` were both attacker-supplied strings, and alert ids
      // were wall-clock milliseconds and therefore guessable. Anyone who knew
      // a victim's uid could forge "<name> is responding" onto their live SOS.
      // A false "help is on the way" during a seizure is worse than silence.
      //
      // The callable derives alertOwnerId, contactId and contactName from the
      // alert and the caller's accepted contact, so none of them can be
      // spoofed, and it bounds the note length.
      allow create, update: if false;

      allow delete: if isResponder();
    }

    // ── Circle invites ────────────────────────────────────────────────────────
    // Sender and recipient are different users, so this can't be scoped by a
    // single owner field. Both sides may read their own invites; all writes
    // (create/accept/decline) go through the trusted sendCircleInvite /
    // respondToInvite Cloud Functions, which use the Admin SDK and so bypass
    // these rules entirely — clients never write invites directly.

    // ── Rate limits ───────────────────────────────────────────────────────────
    // Per-user call counters, written only by the Cloud Functions under the
    // Admin SDK. Denied to clients outright: a limit the caller can reset is
    // not a limit.

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read:  if isAuthed()
                   && (resource.data.senderUid == request.auth.uid
                       || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }
  }
}
