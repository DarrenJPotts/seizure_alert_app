rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

function isAuthed() {
      return request.auth != null;
    }

function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

function hasValidOptionalSaPhone(data) {
      return !('phone' in data)
        || data.phone == null
        || (data.phone is string
          && data.phone.size() <= 15
          && data.phone.matches('^(0[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|\\+27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|0027[1-8][0-9]{8}|[1-8][0-9] ?[0-9]{3} ?[0-9]{4})$')
          && data.phoneNormalized is string
          && data.phoneNormalized.matches('^\\+27[1-8][0-9]{8}$'));
    }

    function hasValidRequiredSaPhone(data) {
      return 'phone' in data
        && data.phone is string
        && data.phone.size() <= 15
        && data.phone.matches('^(0[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|\\+27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|27 ?[1-8][0-9] ?[0-9]{3} ?[0-9]{4}|0027[1-8][0-9]{8}|[1-8][0-9] ?[0-9]{3} ?[0-9]{4})$')
        && data.phoneNormalized is string
        && data.phoneNormalized.matches('^\\+27[1-8][0-9]{8}$');
    }

match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
                    && hasValidOptionalSaPhone(request.resource.data);
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['phone', 'phoneNormalized'])
                        || hasValidOptionalSaPhone(request.resource.data));
    }

match /contacts/{contactId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;

      allow create:       if isOwner(request.resource.data.userId)
                          && hasValidRequiredSaPhone(request.resource.data)
                          && !('linkedUid' in request.resource.data);

      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId
                          && (!request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['phone', 'phoneNormalized'])
                              || hasValidRequiredSaPhone(request.resource.data))
                          && !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny(['linkedUid']);
    }

match /seizureLogs/{logId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId;
    }

match /alerts/{alertId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId;
    }

match /headsUp/{headsUpId} {
      allow read, delete: if isAuthed()
                          && resource.data.userId == request.auth.uid;
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isAuthed()
                          && resource.data.userId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId;
    }

match /alert_responses/{responseId} {

      function isResponder() {
        return isAuthed() && resource.data.responderId == request.auth.uid;
      }

function isAlertOwner() {
        return isAuthed() && resource.data.alertOwnerId == request.auth.uid;
      }

      allow read: if isResponder() || isAlertOwner();

allow create, update: if false;

      allow delete: if isResponder();
    }

match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read:  if isAuthed()
                   && (resource.data.senderUid == request.auth.uid
                       || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

match /system/{docId} {
      allow read, write: if false;
    }
  }
}
